	<xs:element name="ModInfoXML">
		<xs:complexType>
			<xs:annotation>
				<xs:documentation>Mod Information for a Total Miner mod. Every mod is required to have a `ModInfo.xml` file with a `ModInfoXML` element.</xs:documentation>
			</xs:annotation>
			<xs:all>
				<xs:element name="ID" type="NonEmptyString" minOccurs="1">
					<xs:annotation>
						<xs:documentation>The ID of the mod when used from your local mods folder.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="WorkshopID" type="NonEmptyString" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The ID of the mod when used from your downloaded Steam Workshop mods.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Name" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The name of the mod shown in-game. If not used, the mod folder's name will be used instead.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Desc" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The description of the mod shown.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Author" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The author of the mod shown in-game in the mod information.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Website" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>A website link shown in-game in the mod information.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Icon" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The icon of the mod shown in-game. If not used, the mod in-game will not have an icon. The value of `Icon` should also include the file extension.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Version" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The version of the mod shown in-game. If not used or is missing any of the child elements, it will be shown as version `1.0.0`. Uses <a href="https://semver.org/">Systemic Versioning</a>.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element name="Major" type="xs:integer" minOccurs="1">
								<xs:annotation>
									<xs:documentation>The current change that breaks backwards compatability.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Minor" type="xs:integer" minOccurs="1">
								<xs:annotation>
									<xs:documentation>The current change that adds additions that supports backwards compatability.</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Patch" type="xs:integer" minOccurs="1">
								<xs:annotation>
									<xs:documentation>The current change that fixes bugs that supports backwards compatability.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>

