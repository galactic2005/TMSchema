<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!-- definition of types -->
	<xs:simpleType name="AttributeDamageType">
		<xs:restriction base="xs:string">
				<xs:enumeration value="Blast">
					<xs:annotation>
						<xs:documentation>Damage dealt by explosives.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="BlockCollision">
					<xs:annotation>
						<xs:documentation>Damage dealt by colliding with blocks (such as `Steel Spikes`.)</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="BlockFallingOnHead">
					<xs:annotation>
						<xs:documentation>Damage dealt by falling blocks affected by gravity.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Burning">
					<xs:annotation>
						<xs:documentation>Damage dealt by being set on fire from any source.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Combat">
					<xs:annotation>
						<xs:documentation>Damage dealt through combat encounters with other Actors.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Drowning">
					<xs:annotation>
						<xs:documentation>Damage dealt by drowning (running out of Oxygen) while underwater.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Effect">
					<xs:annotation>
						<xs:documentation>Damage dealt while being effected by an effect.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Food">
					<xs:annotation>
						<xs:documentation>Damage dealt by consuming food with negative health regeneration values.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Hail">
					<xs:annotation>
						<xs:documentation>Damage dealt by hail from the weather.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ItemUse">
					<xs:annotation>
						<xs:documentation>Damage dealt by swinging an item.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="ShieldDeflect">
					<xs:annotation>
						<xs:documentation>Damage dealt that was deflected by a Shield item (light-blue damage number.)</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Sprinting">
					<xs:annotation>
						<xs:documentation>Unused Damage Type.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Unknown">
					<xs:annotation>
						<xs:documentation>Damage dealt through other methods not defined.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="BoundaryHeight">
		<xs:annotation>
			<xs:documentation>The height of a Boundary or Collision Box.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="BoundaryWidth">
		<xs:annotation>
			<xs:documentation>The width of a Boundary or Collision Box.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ColorInteger">
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="255"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ComName">
		<xs:annotation>
			<xs:documentation>The name of a Component file. Does not need file extension.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="NonEmptyString">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="NonSpaceString">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:pattern value="[^ ]*"/>
			<xs:whiteSpace value="replace"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PercentDecimal">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0.0"/>
			<xs:maxInclusive value="1.0"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PercentInteger">
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="100"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="PositiveDecimal">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="Vector2">
		<xs:all>
			<xs:element name="X" type="xs:float" minOccurs="1"/>
			<xs:element name="Y" type="xs:float" minOccurs="1"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="Vector2Optional">
		<xs:all minOccurs="0">
			<xs:element name="X" type="xs:float"/>
			<xs:element name="Y" type="xs:float"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="Vector3">
		<xs:all>
			<xs:element name="X" type="xs:float" minOccurs="1"/>
			<xs:element name="Y" type="xs:float" minOccurs="1"/>
			<xs:element name="Z" type="xs:float" minOccurs="1"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="Vector3Optional">
		<xs:all minOccurs="0">
			<xs:element name="X" type="xs:float" minOccurs="1"/>
			<xs:element name="Y" type="xs:float" minOccurs="1"/>
			<xs:element name="Z" type="xs:float" minOccurs="1"/>
		</xs:all>
	</xs:complexType>

	<!-- definition of depreciated elements -->
	<xs:simpleType name="ActorAIAttackRange">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Use `BowRange` for Bow items, `StrikeRange` for the NPC's hand, or items with a Range parameter.</xs:appinfo>
			<xs:documentation>Unused Actor AI Data.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataComName">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `IdleKeyframes`.</xs:appinfo>
			<xs:documentation>Unused Actor Type Component Data.<br/>Used to be an array that contains one or more of `ComName` for the Actor Type's `Idle` animation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="ActorTypeDataComNameWalk">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `WalkKeyframes`.</xs:appinfo>
			<xs:documentation>Unused Actor Type Component Data.<br/>Used to be an array that contains one or more of `ComName` for the Actor Type's `Walk` animation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComName" type="ComName" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="ActorTypeDataIsImmuneToFire">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `FireResistance`; set `FireResistance` to `100` to achieve the same effect.<br/>Used to be an element that if `true`, the Actor Type will be immune to the Fire effect.</xs:appinfo>
			<xs:documentation>Unused Actor Type Data.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataNaturalSpawnFreq">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with the Spawn Rule system (see `SpawnRuleXML` and `ModSpawnRuleXML` for more information.)</xs:appinfo>
			<xs:documentation>Unused Actor Type Data.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:element name="AttributeLootItemBlockItem" abstract="true"/>
	<xs:element name="Block" substitutionGroup="AttributeLootItemBlockItem">
		<xs:annotation>
			<xs:documentation>The `BlockID` of the Block to drop. Cannot use with `Item`.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Item" substitutionGroup="AttributeLootItemBlockItem">
		<xs:annotation>
			<xs:documentation>The `ItemID` of the Item to drop. Cannot use with `Block`.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:complexType name="AttributeLootItem">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `Entries`.</xs:appinfo>
			<xs:documentation>An Loot Item Entry for a `LootTable`.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element ref="AttributeLootItemBlockItem" minOccurs="1"/>
			<xs:element name="Chance" type="PercentInteger" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The percent chance of the Loot Item occuring.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Count1" type="xs:nonNegativeInteger" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The minimum amount of the Block or Item to drop. Set to the value of `Count2` to guarantee a specific amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Count2" type="xs:nonNegativeInteger" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The maximum amount of the Block or Item to drop. Set to the value of `Count1` to guarantee a specific amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Damage" type="AttributeDamageType" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `DamageType`.</xs:appinfo>
					<xs:documentation>The type of damage required for the Loot Item to occur. Set to `Unknown` for the Loot Item to occur regardless of Damage Type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DamageType" type="AttributeDamageType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The type of damage required for the Loot Item to occur. Set to `Unknown` for the Loot Item to occur regardless of Damage Type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Percent" type="PercentInteger" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Replaced with `Chance`.</xs:appinfo>
					<xs:documentation>The percent chance of the Loot Item occuring.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>

	<xs:simpleType name="ModInfoXMLDepreciatedVersion">
		<xs:annotation>
			<xs:appinfo>**Depreciated** as of `v2.31.1.3154`. Use the `Major`, `Minor` and `Patch` child elements.</xs:appinfo>
			<xs:documentation>The version of the mod shown in-game. If not used, it will be shown as version `1.0.0.0`. Uses <a href="https://semver.org/">Systemic Versioning</a>.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger">
			<xs:totalDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- definition of simple elements -->
	<xs:simpleType name="ActorAIBowRange">
		<xs:annotation>
			<xs:documentation>The distance in blocks that the NPC will attempt to attack a target from with a Bow item. If the target is outside of range, the NPC will not attack.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAIHearingRange">
		<xs:annotation>
			<xs:documentation>The distance in blocks that the NPC will hear the target from. Used for the `IsAudible` behaviour node.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAIInactiveRange">
		<xs:annotation>
			<xs:documentation>The distance in blocks that all players must be away from the NPC for it to despawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAIRegardRange">
		<xs:annotation>
			<xs:documentation>The distance in blocks that the NPC will notice or see the target from.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAIStrikeDelay">
		<xs:annotation>
			<xs:documentation>The time in seconds between attacks from the NPC.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAIStrikeRange">
		<xs:annotation>
			<xs:documentation>The distance in blocks the NPC's attacks will reach using their hand (no items or items without reach.)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAudioAudioDeath">
		<xs:annotation>
			<xs:documentation>The sound effect that plays when the Actor Type dies from any source.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAudioAudioPain">
		<xs:annotation>
			<xs:documentation>The sound effect that plays when the Actor Type takes damage.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAudioAudioStrike">
		<xs:annotation>
			<xs:documentation>Unused Actor Audio Data.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorAudioAudioWarning">
		<xs:annotation>
			<xs:documentation>The sound effect that plays when the Actor Type warns a target.<br/>Currently only used in vanilla for milking a cow NPC.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="ModActorBoundsDataCollisionBoxSize">
		<xs:annotation>
			<xs:documentation>The size of an Actor Type's Collision Box during almost all states.<br/>When an Actor Type or NPC shows their hitboxes, Collision Boxes are colored green.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Height" type="BoundaryHeight" use="optional"/>
		<xs:attribute name="Width" type="BoundaryWidth" use="optional"/>
	</xs:complexType>

	<xs:complexType name="ModActorBoundsDataCrouchCollisionBoxSize">
		<xs:annotation>
			<xs:documentation>The size of an Actor Type's Collision Box when crouched. NPCs cannot crouch, so this is only used by Players.<br/>When an Actor Type or NPC shows their hitboxes, Collision Boxes are colored green.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Height" type="BoundaryHeight" use="optional"/>
		<xs:attribute name="Width" type="BoundaryWidth" use="optional"/>
	</xs:complexType>

	<xs:complexType name="ModActorBoundsDataHitBounds">
		<xs:annotation>
			<xs:documentation>The Boundaries of an Actor Type. Used for hit detection.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Bound" type="HitBoundsBound" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[&lt;Bound DamageMultiplier="Decimal" IsCritical="Boolean"&gt;]]>`</xs:appinfo>
					<xs:documentation>A Boundary of an Actor Type. When an Actor Type or NPC shows their hitboxes, Normal Boundary Boxes are colored yellow.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="ActorLevelDataAttackLevel">
		<xs:annotation>
			<xs:documentation>The Attack Combat Stat level that the NPC will start with from a Spawn Rule. It'll also be the default Attack Combat Stat in a NPC Spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorLevelDataDefenceLevel">
		<xs:annotation>
			<xs:documentation>The Defence Combat Stat level that the NPC will start with from a Spawn Rule. It'll also be the default Defence Combat Stat in a NPC Spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorLevelDataHealthLevel">
		<xs:annotation>
			<xs:documentation>The Health Combat Stat level that the NPC will start with from a Spawn Rule. It'll also be the default Health Combat Stat in a NPC Spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorLevelDataRangedLevel">
		<xs:annotation>
			<xs:documentation>The Ranged Combat Stat level that the NPC will start with from a Spawn Rule. It'll also be the default Ranged Combat Stat in a NPC Spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorLevelDataStrengthLevel">
		<xs:annotation>
			<xs:documentation>The Strength Combat Stat level that the NPC will start with from a Spawn Rule. It'll also be the default Strength Combat Stat in a NPC Spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorPhysicsDataAcceleration">
		<xs:annotation>
			<xs:appinfo>Blocks/s = `Acceleration` * 60</xs:appinfo>
			<xs:documentation>The horizonal speed the NPC will move at with a `VelocityModifier` property of 1.<br/>`0.06` is the `Base` Acceleration value and is what a `Player` runs at; the `Player` walks at `0.057` Acceleration value.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorPhysicsDataJumpSpeed">
		<xs:annotation>
			<xs:documentation>The vertical speed of a jump the NPC will jump with.<br/>`0.155` is the `Base` Jump Speed and is what a `Player` jumps with.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorPhysicsDataMoveSpeed">
		<xs:annotation>
			<xs:documentation>The maximum horizonal speed the NPC will move at if the `Acceleration` element's value is greater.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorPhysicsDataRotateSpeed">
		<xs:annotation>
			<xs:documentation>The speed the NPC will rotate at.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataAIType">
		<xs:annotation>
			<xs:documentation>The ID of the `ActorAIDataXML` or `ModActorAIDataXML` that will be used for this Actor Type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonSpaceString"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataBoundsType">
		<xs:annotation>
			<xs:documentation>The ID of the `ActorBoundsDataXML` that will be used for this Actor Type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonSpaceString"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataLevelType">
		<xs:annotation>
			<xs:documentation>The ID of the `ActorLevelDataXML` or `ModActorLevelDataXML` that will be used for this Actor Type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonSpaceString"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataPhysicsType">
		<xs:annotation>
			<xs:documentation>The ID of the `ActorPhysicsDataXML` or `ModActorPhysicsDataXML` that will be used for this Actor Type.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonSpaceString"/>
	</xs:simpleType>

	<xs:complexType name="ActorTypeDataCrouchIdleKeyframes">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ComName` for the Actor Type's `CrouchIdle` animation. Currently unused by NPCs.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComName" type="ComName" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ActorTypeDataCrouchWalkKeyframes">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ComName` for the Actor Type's `CrouchWalk` animation. Currently unused by NPCs.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComName" type="ComName" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ActorTypeDataIdleKeyframes">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ComName` for the Actor Type's `Idle` animation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComName" type="ComName" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ActorTypeDataWalkKeyframes">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ComName` for the Actor Type's `Walk` animation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ComName" type="ComName" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="ActorTypeDataCanBreatheUnderWater">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type as a NPC can breathe underwater and will not take drowning damage from it.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataExplodeBlocksRatio">
		<xs:annotation>
			<xs:documentation>Seemingly unused.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PercentDecimal"/>
	</xs:simpleType>

	<xs:complexType name="ActorTypeDataExplodeBlocksScale">
		<xs:annotation>
			<xs:documentation>Seemingly unused.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="Vector2Optional"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="ActorTypeDataEyeOffset">
		<xs:annotation>
			<xs:documentation>The offset of the Actor Type's eye position.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="Vector3Optional"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:simpleType name="ActorTypeDataFireResistance">
		<xs:annotation>
			<xs:documentation>The resistance the Actor Type will have to the Fire effect from any source. Fire effect length increases below 0, and decreases above 0. Set to `100` or above for the Actor Type to become immune to the Fire effect.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataHandMaxHit">
		<xs:annotation>
			<xs:documentation>The maximum amount of damage the Actor Type can do with its hand (no items.)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataHasNameplate">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type will show a Nameplate above itself.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIceResistance">
		<xs:annotation>
			<xs:documentation>The resistance the Actor Type will have to the Ice effect from any source. Ice effect length increases below 0, and decreases above 0. Set to `100` or above for the Actor Type to become immune to the Ice effect.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIsFemale">
		<xs:annotation>
			<xs:documentation>Unused Actor Type Data.<br/>If `true`, the Actor Type is considered a female Actor Type..</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIsImmuneToSpikes">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type is immune to `Steel Spikes`.<br/>Fall damage is not handled through this element (see `LandingDamageMultiplier` in the `Properties` behaviour node.)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIsMobile">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type is considered a mobile Actor.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIsPassive">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type as a NPC will be considered a Passive NPC.<br/>Passive NPCs will have a green dot on the Compass, and will only spawn from a Spawn Rule if the `Passive NPCs` Game Difficulty option is Enabled.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataIsValid">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type is valid and can be used in-game.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:complexType name="ActorTypeDataItemModelOffset">
		<xs:annotation>
			<xs:documentation>The offset of the Actor Type's held Item's position when in their hand.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="Vector3Optional"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:simpleType name="ActorTypeDataModelHeight">
		<xs:annotation>
			<xs:documentation>The height of Actor Type's model in blocks. The Actor Type will stretch horizontally to maintain a constant aspect ratio.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PositiveDecimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataModelYRotation">
		<xs:annotation>
			<xs:documentation>The rotation of the Actor Type's model in the Y axis in radians.<br/>A value of `pi` (roughly `3.1416`) turns the model around to face the opposite direction.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataName">
		<xs:annotation>
			<xs:documentation>The name of the Actor Type shown in-game.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataNameArticle">
		<xs:annotation>
			<xs:appinfo>"*User was killed by `<![CDATA[<]]>NameArticle<![CDATA[>]]>` `<![CDATA[<]]>Name<![CDATA[>]]>`.*"</xs:appinfo>
			<xs:documentation>The word placed before the Actor Type's name in a sentance through in-game means (such as in Death Messages.)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataNaturalBehaviour">
		<xs:annotation>
			<xs:documentation>The behaviour of the Actor Type when spawned into the world with a Spawn Rule.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataNPCText">
		<xs:annotation>
			<xs:documentation>The `Dialog Text` given when placed in a `NPC Spawn` block by default.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ActorTypeDataShowHitboxes">
		<xs:annotation>
			<xs:documentation>If `true`, the Actor Type's hitboxes are visible.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="ActorTypeDataStrikePointOffset">
		<xs:annotation>
			<xs:documentation>The offset of the Actor Type's Strike point (where they attack relative in an `Attack` behaviour node) position.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="Vector3Optional"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:simpleType name="AmbientSoundCueName">
		<xs:annotation>
			<xs:documentation>The sound effect's file name to play for the Ambient Sound effect.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="AmbientSoundIsValid">
		<xs:annotation>
			<xs:documentation>If `true`, the Ambient Sound is valid and can be used in-game.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="AmbientSoundName">
		<xs:annotation>
			<xs:documentation>The name of the Ambient Sound effect shown in-game in menus.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="DeathMessageMessage">
		<xs:annotation>
			<xs:documentation>The specified `Message` of the Death Message.<br/>`{0}` replaces the text with the Actor's own name.<br/>`{1}` replaces the text with the Actor's Target name (if they were killed by another Actor.)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataAttack">
		<xs:annotation>
			<xs:documentation>The Attack Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Attack skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataDefence">
		<xs:annotation>
			<xs:documentation>The Defence Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Defence skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataHealth">
		<xs:annotation>
			<xs:documentation>The Health Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Health skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataItemID">
		<xs:annotation>
			<xs:documentation>The ID of the item.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataLooting">
		<xs:annotation>
			<xs:documentation>The Looting Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Looting skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataMagic">
		<xs:annotation>
			<xs:documentation>Seemingly unused Combat Stat.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataRanged">
		<xs:annotation>
			<xs:documentation>The Ranged Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Ranged skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemCombatDataStrength">
		<xs:annotation>
			<xs:documentation>The Strength Combat Stats bonus of the item. Every 100 bonuses equals to 1 level of the Strength skill.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer"/>
	</xs:simpleType>

	<xs:simpleType name="ItemRarityDataRarityType">
		<xs:annotation>
			<xs:documentation>The ID of the item rarity.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="ItemRarityDataName">
		<xs:annotation>
			<xs:documentation>The name of the item rarity shown in-game.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="ItemRarityDataModdedColor">
		<xs:annotation>
			<xs:appinfo>`<![CDATA[&lt;Color R="ColorInteger" G="ColorInteger" B="ColorInteger"/&gt;]]>`</xs:appinfo>
			<xs:documentation>The color of the item rarity in-game.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="R" type="ColorInteger" use="required">
			<xs:annotation>
				<xs:documentation>An integer between 0 to 255 that represents Red.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="G" type="ColorInteger" use="required">
			<xs:annotation>
				<xs:documentation>An integer between 0 to 255 that represents Green.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="B" type="ColorInteger" use="required">
			<xs:annotation>
				<xs:documentation>An integer between 0 to 255 that represents Blue.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="ItemTypeClassDataPower">
		<xs:annotation>
			<xs:documentation>The power level of the item, or the amount of "damage" it deals to a block. A block's "health" is its Resistance.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ItemTypeClassDataMaxResistance">
		<xs:annotation>
			<xs:documentation>The maximum amount of Resistance a block may have to be broken by this item. If a block has more Resistance than this value, then the block cannot be broken by the item.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="ItemTypeDataItemID">
		<xs:annotation>
			<xs:documentation>The Item ID of the item the Item Type Data should apply to.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonEmptyString"/>
	</xs:simpleType>

	<xs:simpleType name="ItemTypeDataUse">
		<xs:annotation>
			<xs:documentation>How the item is used in gameplay.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="NonEmptyString">
			<xs:enumeration value="Block">
				<xs:annotation>
					<xs:documentation>The item is used like a Block.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Item">
				<xs:annotation>
					<xs:documentation>The item is used like a Item.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="None">
				<xs:annotation>
					<xs:documentation>The item isn't used like a Block or Item.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="ModInfoXMLVersion">
		<xs:annotation>
			<xs:documentation>The version of the mod shown in-game. If not used or is missing any of the child elements, it will be shown as version `1.0.0`. Uses <a href="https://semver.org/">Systemic Versioning</a>.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="Major" type="xs:integer" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The current change that breaks backwards compatability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Minor" type="xs:integer" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The current change that adds additions that supports backwards compatability.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Patch" type="xs:integer" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The current change that fixes bugs that supports backwards compatability.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>

	<xs:simpleType name="PlaylistName">
		<xs:annotation>
			<xs:documentation>The name of the Playlist used in-game</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="PlaylistSongs">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `string` within a Playlist. Songs are chosen randomly from the array in-game.<br/>If left blank, the Playlist will not play any music.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="string" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The name of a song that can be played within a Playist.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="SpawnRuleActorType">
		<xs:annotation>
			<xs:documentation>The Actor Type that will spawn from the Spawn Rule.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleChance">
		<xs:annotation>
			<xs:documentation>The chance as a percentage that the NPC will succeed in a spawn.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="PercentInteger"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleFrequency">
		<xs:annotation>
			<xs:documentation>How many NPCs can spawn from this Spawn Rule. If the amount of active NPCs meet or exceeds the `SpawnCap`, all spawns fail.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleGroupSize">
		<xs:annotation>
			<xs:documentation>The amount of NPCs from this Spawn Rule that will spawn upon a successful spawn. Spawns ignore the `SpawnCap` and can exceed it.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleIsValid">
		<xs:annotation>
			<xs:documentation>If `true`, the Spawn Rule is valid and can spawn NPCs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleShouldDespawn">
		<xs:annotation>
			<xs:documentation>If `true`, the NPC will despawn if the time of day does not match the `Time` element. Not affected by, nor affects, the `ChangeState` or `Deactivate` behaviour nodes.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:boolean"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleSpawnCap">
		<xs:annotation>
			<xs:documentation>How many NPCs can spawn from this Spawn Rule. If the amount of active NPCs meet or exceeds the `SpawnCap`, all spawns fail.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>

	<xs:simpleType name="SpawnRuleTime">
		<xs:annotation>
			<xs:documentation>What time of the day the Spawn Rule will be active. If set to `None`, the Spawn Rule is permanently active regardless of the time of day.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Day">
				<xs:annotation>
					<xs:documentation>The Spawn Rule will be active only during the day.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Night">
				<xs:annotation>
					<xs:documentation>The Spawn Rule will be active only during the night.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="None">
				<xs:annotation>
					<xs:documentation>The Spawn Rule will be active during all times of the day.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<!-- definition of complex elements -->
	<xs:complexType name="AttributeCondition">
		<xs:annotation>
			<xs:appinfo>`<![CDATA[&lt;Condition Type="ConditionType" DamageType="DamageTypeString" ItemID="ItemIDString" Target="TargetString" Comparison="Comparitor" Value="Any"/&gt;]]>`</xs:appinfo>
			<xs:documentation>The condition or conditions that must be met for the element to be active.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Condition" type="AttributeCondition" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="Comparison" type="AttributeConditionComparison" use="optional">
			<xs:annotation>
				<xs:documentation>The comparison of the condition against `Value`.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="DamageType" type="AttributeDamageType" use="optional">
			<xs:annotation>
				<xs:documentation>The type of damage inflicted in the condition (if any.)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="HistoryType" type="AttributeConditionHistory" use="optional">
			<xs:annotation>
				<xs:documentation>The type of History to compare in the condition.<br/>Used exclusively for `Type="History"`.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ItemID" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>The `ItemID` of the condition.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Name" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>The `Name` of the condition.<br/>Used exclusively for `Type="History"`.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Percent" type="PercentInteger" use="optional">
			<xs:annotation>
				<xs:documentation>The `Percent` chance of the condition.<br/>Used exclusively for `Type="Chance"`.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Target" type="AttributeConditionTarget" use="optional">
			<xs:annotation>
				<xs:documentation>Sets the compared target of the condition.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Value" type="xs:anySimpleType" use="optional">
			<xs:annotation>
				<xs:documentation>The value of the condition.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Type" type="AttributeConditionType" use="required">
			<xs:annotation>
				<xs:documentation>The type of the condition.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>


	<xs:complexType name="AttributeDrop">
		<xs:annotation>
			<xs:appinfo>`<![CDATA[&lt;Drop ItemID="ItemIDString" Min="Integer" Max="Integer" Weight="Integer"/&gt;]]>`</xs:appinfo>
			<xs:documentation>An Item Drop from a `DropEntry` element.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="ItemID" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation>The `ItemID` of the Item to be dropped from the `Drop` element.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Min" type="xs:nonNegativeInteger" use="required">
			<xs:annotation>
				<xs:documentation>The minimum amount of the `ItemID` possble from the `Drop` element.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Max" type="xs:nonNegativeInteger" use="required">
			<xs:annotation>
				<xs:documentation>The maximum amount of the `ItemID` possible from the `Drop` element.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Weight" type="xs:nonNegativeInteger" use="required">
			<xs:annotation>
				<xs:documentation>The weight of the `Drop` element. Heavier weighed elements are more likely to be randomly chosen than lighter weighed elements.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="AttributeDropEntry">
		<xs:annotation>
			<xs:appinfo>`<![CDATA[&lt;DropEntry ID="DropEntryID" PercentChance="Integer(0-100)" RollCount="Integer" Modify="Boolean" Remove="Boolean"&gt;]]>`</xs:appinfo>
			<xs:documentation>An Item Drop Entry for a `LootTable`. `Drop` elements are chosen at random based on their weight.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Condition" type="AttributeCondition" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Drop" type="AttributeDrop" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="ID" type="NonEmptyString" use="required">
			<xs:annotation>
				<xs:documentation>The ID of the `DropEntry`. If the `ID` is not unique, it'll overwrite the Drop Entry with the same `ID`.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Modify" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>If `true`, then the `DropEntry` will not be overwritten and only added onto.<br/>Works only if the `LootTable` parent has the `Modify="true"` attribute.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="PercentChance" type="PercentInteger" use="required">
			<xs:annotation>
				<xs:documentation>The chance of the Drop Entry occuring.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Remove" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>If `true`, then the `DropEntry` will be overwritten as if it wasn't being modified.<br/>Works only if the `LootTable` parent has the `Modify="true"` attribute.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="RollCount" use="required">
			<xs:annotation>
				<xs:documentation>The amount of times the Drop Entry will randomly pick a `Drop` element.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:nonNegativeInteger">
					<xs:minInclusive value="1"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="HitBoundsBound">
		<xs:sequence>
			<xs:element name="Offset" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[&lt;Offset X="Decimal" Y="Decimal" Z="Decimal"&gt;]]>`</xs:appinfo>
					<xs:documentation>The offset of the Boundary against the Actor Type's current position view relative.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="X" type="xs:decimal" use="optional">
						<xs:annotation>
							<xs:documentation>Moves the Actor Type's Boundary horizontally to the left and right.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Y" type="xs:decimal" use="optional">
						<xs:annotation>
							<xs:documentation>Moves the Actor Type's Boundary vertically.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
					<xs:attribute name="Z" type="xs:decimal" use="optional">
						<xs:annotation>
							<xs:documentation>Moves the Actor Type's Boundary horizontally to the front and back.</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
			<xs:element name="Size" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[&lt;Size Width="Decimal" Height="Decimal"&gt;]]>`</xs:appinfo>
					<xs:documentation>The size of the Boundary.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="Height" type="BoundaryHeight" use="optional"/>
					<xs:attribute name="Width" type="BoundaryWidth" use="optional"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="DamageMultiplier" type="PositiveDecimal" use="optional">
			<xs:annotation>
				<xs:documentation>The Damage Multiplier of the Boundary. Values below `1` reduce damage while values above `1` increase damage.<br/>Not associated with the `IsCritical` attribute.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="IsCritical" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>If the Boundary is considered a Critical Boundary. When an Actor Type or NPC shows their hitboxes, Critical Boundary Boxes are colored pink.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="LootTable">
		<xs:sequence>
			<xs:element name="Entries" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[&lt;Entries Modify="Boolean"&gt;]]>`</xs:appinfo>
					<xs:documentation>An array that contains `DropEntry`.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DropEntry" type="AttributeDropEntry" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="LootItem" type="AttributeLootItem" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="Modify" type="xs:boolean" use="optional">
			<xs:annotation>
				<xs:documentation>If `true`, then any `DropEntry` IDs not specified in the `Entries` will not be affected.<br/>This allows you to add or overwrite specific IDs without affecting other ones.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- definition of attributes -->
	<xs:simpleType name="AttributeConditionComparison">
		<xs:restriction base="xs:string">
			<xs:enumeration value="LessThan">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[<]]>`</xs:appinfo>
					<xs:documentation>If the compared `Type` is less than `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LessThanOrEqual">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[<=]]>`</xs:appinfo>
					<xs:documentation>If the compared `Type` is less than or equal to `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Equal">
				<xs:annotation>
					<xs:appinfo>`=`</xs:appinfo>
					<xs:documentation>If the compared `Type` is equal to `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GreaterThanOrEqual">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[>=]]>`</xs:appinfo>
					<xs:documentation>If the compared `Type` is equal to or greater than `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GreaterThan">
				<xs:annotation>
					<xs:appinfo>`<![CDATA[>]]>`</xs:appinfo>
					<xs:documentation>If the compared `Type` is greater than `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NotEqual">
				<xs:annotation>
					<xs:appinfo>`!=`</xs:appinfo>
					<xs:documentation>If the compared `Type` is not equal to `Value`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="AttributeConditionHistory">
		<xs:restriction base="xs:string">
				<xs:enumeration value="Actor">
					<xs:annotation>
						<xs:documentation>The compared Actor's history.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Clan">
					<xs:annotation>
						<xs:documentation>The compared Actor's Clan history. If the compared Actor is not in a clan, then no History can be checked.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="System">
					<xs:annotation>
						<xs:documentation>The World's history.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="AttributeConditionTarget">
		<xs:restriction base="xs:string">
				<xs:enumeration value="Self">
					<xs:annotation>
						<xs:documentation>The compared Actor/Block of the condition.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="Target">
					<xs:annotation>
						<xs:documentation>The compared Actor/Block of the condition's targetted Actor/Block.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="AttributeConditionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="GameMode">
				<xs:annotation>
					<xs:appinfo>`Type="GameMode" Value="GameModeString"`</xs:appinfo>
					<xs:documentation>The Game Mode of the World. The following values are compared:<br/>* `Creative`<br/>* `DigDeep`<br/>* `Peaceful`<br/>* `Survival`<br/>Example:<br/></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SkillsEnabled">
				<xs:annotation>
					<xs:appinfo>`Type="SkillsEnabled" Value="Boolean"`</xs:appinfo>
					<xs:documentation>Whether Local or Global skills are enabled on the World.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Time">
				<xs:annotation>
					<xs:appinfo>`Type="Time" Comparison="Comparitor" Value="Decimal(0-24)"`</xs:appinfo>
					<xs:documentation>The current time of the World. The value compared is a decimal between 0 to 24.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WorldType">
				<xs:annotation>
					<xs:appinfo>`Type="WorldType" Value="WorldTypeString"`</xs:appinfo>
					<xs:documentation>The World Type (or Biome) of the World. The following values are compared:<br/>* `DigDeep`<br/>* `Flat`<br/>* `Grasslands`<br/>* `MultiBiome`<br/>* `SemiAlpine`</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Health">
				<xs:annotation>
					<xs:appinfo>`Type="Health" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The current Health of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaxHealth">
				<xs:annotation>
					<xs:appinfo>`Type="MaxHealth" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The maximum Health of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Oxygen">
				<xs:annotation>
					<xs:appinfo>`Type="Oxygen" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The current Oxygen of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaxOxygen">
				<xs:annotation>
					<xs:appinfo>`Type="MaxOxygen" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The maximum Oxygen of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Stamina">
				<xs:annotation>
					<xs:appinfo>`Type="Stamina" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The current Stamina of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaxStamina">
				<xs:annotation>
					<xs:appinfo>`Type="MaxStamina" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>The maximum Stamina of the compared Actor.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsItemEquipped">
				<xs:annotation>
					<xs:appinfo>`Type="IsItemEquipped" ItemID="ItemIDString" Value="Boolean"`</xs:appinfo>
					<xs:documentation>If the compared Actor has the specified `ItemID` equipped.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HasItem">
				<xs:annotation>
					<xs:appinfo>`Type="HasItem" ItemID="ItemIDString" Value="Boolean"`</xs:appinfo>
					<xs:documentation>If the compared Actor has the specified `ItemID` in their inventory.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HasItemCount">
				<xs:annotation>
					<xs:appinfo>`Type="HasItemCount" ItemID="ItemIDString" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>If the compared Actor has the specified `ItemID` in their inventory in a specific quantity.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DamageType">
				<xs:annotation>
					<xs:appinfo>`Type="DamageType" DamageType="DamageTypeString" Value="Boolean"`</xs:appinfo>
					<xs:documentation>The Damage Type inflicted upon the compared actor. The following values are compared:<br/>* `Blast`<br/>* `BlockCollision`<br/>* `BlockFallingOnHead`<br/>* `Burning`<br/>* `Combat`<br/>* `Drowning`<br/>* `Effect`<br/>* `Food`<br/>* `Hail`<br/>* `ItemUse`<br/>* `ShieldDeflect`<br/>* `Sprinting`<br/>* `Unknown`</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ActorType">
				<xs:annotation>
					<xs:appinfo>`Type="ActorType" Value="ActorTypeString"`</xs:appinfo>
					<xs:documentation>If the compared Actor is of a specified Actor Type.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsPlayer">
				<xs:annotation>
					<xs:appinfo>`Type="IsPlayer" Value="Boolean"`</xs:appinfo>
					<xs:documentation>If the compared Actor is a Player.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsNPC">
				<xs:annotation>
					<xs:appinfo>`Type="IsNPC" Value="Boolean"`</xs:appinfo>
					<xs:documentation>If the compared Actor is a NPC.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ActorExists">
				<xs:annotation>
					<xs:appinfo>`Type="ActorExists" Value="Boolean"`</xs:appinfo>
					<xs:documentation>If the compared Actor exists within the World.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="X">
				<xs:annotation>
					<xs:documentation>The X value in the world space to compare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Y">
				<xs:annotation>
					<xs:documentation>The Y value in the world space to compare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Z">
				<xs:annotation>
					<xs:documentation>The Z value in the world space to compare.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Depth">
				<xs:annotation>
					<xs:appinfo>`Type="Depth" Comparison="Comparitor" Value="Decimal(0-1)"`</xs:appinfo>
					<xs:documentation>How deep the compared Actor is. The value compared is a decimal between 0 (surface) to 1 (Bedrock.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsNatural">
				<xs:annotation>
					<xs:appinfo>`Type="IsNatural" Value="Boolean"`</xs:appinfo>
					<xs:documentation>Can only target Blocks. If the compared Block was naturally generated by the world.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsBlock">
				<xs:annotation>
					<xs:appinfo>`Type="IsBlock" Value="BlockID"`</xs:appinfo>
					<xs:documentation>The `BlockID` of the block stood on by the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BlockX"/>
			<xs:enumeration value="BlockY"/>
			<xs:enumeration value="BlockZ"/>
			<xs:enumeration value="BlockDepth">
				<xs:annotation>
					<xs:appinfo>`Type="BlockDepth" Comparison="Comparitor" Value="Decimal(0-1)"`</xs:appinfo>
					<xs:documentation>The `Depth` of the block stood on by the compared Actor. The value compared is a decimal between 0 (surface) to 1 (Bedrock.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BlockLight">
				<xs:annotation>
					<xs:appinfo>`Type="BlockLight" Comparison="Comparitor" Value="Integer(0-15)"`</xs:appinfo>
					<xs:documentation>The light level based on the light from any placed blocks where the compared Actor is at. The value compared is a integer between 0 (unlit) to 15 (fully lit.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SkyLight">
				<xs:annotation>
					<xs:appinfo>`Type="SkyLight" Comparison="Comparitor" Value="Integer(0-15)"`</xs:appinfo>
					<xs:documentation>The light level based on the light from the Sky where the compared Actor is at. The value compared is a integer between 0 (unlit) to 15 (fully lit.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IsAux"/>
			<xs:enumeration value="All">
				<xs:annotation>
					<xs:appinfo>`Type="All"`</xs:appinfo>
					<xs:documentation>If all of the sub-conditions are `true`, than the comparison is `true`; otherwise `false`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Any">
				<xs:annotation>
					<xs:appinfo>`Type="Any"`</xs:appinfo>
					<xs:documentation>If any of the sub-conditions are `true`, than the comparison is `true`; otherwise `false`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Not">
				<xs:annotation>
					<xs:appinfo>`Type="Not"`</xs:appinfo>
					<xs:documentation>The comparison will be the inverse of the child comparison (`true` becomes `false` and vice-versa.) Can only have one `Condition` element.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="Chance">
				<xs:annotation>
					<xs:appinfo>`Type="Chance" Percent="PercentInteger"`</xs:appinfo>
					<xs:documentation>Has a 1 in `Percent` chance for the comparison to be `true`; otherwise `false`.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="History">
				<xs:annotation>
					<xs:appinfo>`Type="History" HistoryType="HistoryTypeString" Name="NameString" Comparison="Comparitor" Value="Integer"`</xs:appinfo>
					<xs:documentation>If the History of a specified name and type (`System`, `Actor`, or `Clan`) exists, then the comparison is `true`; otherwise `false`.<br/>Use `Target` to change the compared Actor.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<!-- definition of modded elements -->
	<xs:complexType name="ItemXML">
		<xs:annotation>
			<xs:documentation>Custom Texture Data that allows for overwriting vanilla or modded item textures.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ItemID" type="xs:string">
				<xs:annotation>
					<xs:documentation>The `ItemID` to set the texture for.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ArrayOfItemXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ItemXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ItemXML" type="ItemXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorAIDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor AI Data that allows for customizable vanilla or modded NPCs' AI data.<br/>It's used for the AI a NPC of this Actor Type to determine how it works in gameplay.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorAIType" type="NonEmptyString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ModActorAIDataXML`. If the `ID` is not unique, it'll modify the Actor AI Data with the same `ID`.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StrikeDelay" type="ActorAIStrikeDelay" minOccurs="0"/>
			<xs:element name="StrikeRange" type="ActorAIStrikeRange" minOccurs="0"/>
			<xs:element name="BowRange" type="ActorAIBowRange" minOccurs="0"/>
			<xs:element name="RegardRange" type="ActorAIRegardRange" minOccurs="0"/>
			<xs:element name="HearingRange" type="ActorAIHearingRange" minOccurs="0"/>
			<xs:element name="InactiveRange" type="ActorAIInactiveRange" minOccurs="0"/>

			<!-- depreciated -->
			<xs:element name="AttackRange" type="ActorAIAttackRange" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="ArrayOfModActorAIDataXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ModActorAIDataXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModActorAIDataXML" type="ModActorAIDataXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorAudioDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor AI Data that allows for customizable vanilla or modded NPCs' Audio data.<br/>It's used for the audio cues this Actor Type will emit through gameplay.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorType" type="NonEmptyString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ModActorAudioDataXML`. If the `ID` is not unique, it'll modify the Actor Audio Data with the same `ID`.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AudioPain" type="ActorAudioAudioPain" minOccurs="0"/>
			<xs:element name="AudioStrike" type="ActorAudioAudioStrike" minOccurs="0"/>
			<xs:element name="AudioWarning" type="ActorAudioAudioWarning" minOccurs="0"/>
			<xs:element name="AudioDeath" type="ActorAudioAudioDeath" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="ArrayOfModActorAudioDataXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ModActorAudioDataXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModActorAudioDataXML" type="ModActorAudioDataXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorBoundsDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor Boundaries (otherwise known as Hitboxes) Data that allows for customizable vanilla or modded NPCs' Boundaries data.<br/>It's used for the Boundaries a NPC of this Actor Type will have, including special properties a Boundary may have, alongside their Collision Box.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorBoundsType" type="NonEmptyString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ModActorBoundsDataXML`. If the `ID` is not unique, it'll modify the Actor Boundaries Data with the same `ID`.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CollisionBoxSize" type="ModActorBoundsDataCollisionBoxSize" minOccurs="0"/>
			<xs:element name="CrouchCollisionBoxSize" type="ModActorBoundsDataCrouchCollisionBoxSize" minOccurs="0"/>
			<xs:element name="HitBounds" type="ModActorBoundsDataHitBounds" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="ArrayOfModActorBoundsDataXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ModActorBoundsDataXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModActorBoundsDataXML" type="ModActorBoundsDataXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorLevelDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor Combat Stats Level Data that allows for customizable vanilla or modded NPCs' Combat Stats Level data.<br/>It's used for the default Combat Stats a NPC of this Actor Type will start with from either a Spawn Rule or when using a new NPC Spawn block.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorLevelType" type="NonEmptyString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ModActorLevelDataXML`. If the `ID` is not unique, it'll modify the Actor Combat Stats Level Data with the same `ID`.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HealthLevel" type="ActorLevelDataHealthLevel" minOccurs="0"/>
			<xs:element name="AttackLevel" type="ActorLevelDataAttackLevel" minOccurs="0"/>
			<xs:element name="StrengthLevel" type="ActorLevelDataStrengthLevel" minOccurs="0"/>
			<xs:element name="DefenceLevel" type="ActorLevelDataDefenceLevel" minOccurs="0"/>
			<xs:element name="RangedLevel" type="ActorLevelDataRangedLevel" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="ArrayOfModActorLevelDataXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ModActorLevelDataXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModActorLevelDataXML" type="ModActorLevelDataXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorPhysicsDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor Physics Data that allows for customizable vanilla or modded NPCs' Physics data.<br/>It's used for how a NPC of this Actor Type will move through the world.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorPhysicsType" type="NonEmptyString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ModActorPhysicsDataXML`. If the `ID` is not unique, it'll modify the Actor Physics Data with the same `ID`.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Acceleration" type="ActorPhysicsDataAcceleration" minOccurs="0"/>
			<xs:element name="MoveSpeed" type="ActorPhysicsDataMoveSpeed" minOccurs="0"/>
			<xs:element name="JumpSpeed" type="ActorPhysicsDataJumpSpeed" minOccurs="0"/>
			<xs:element name="RotateSpeed" type="ActorPhysicsDataRotateSpeed" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="ArrayOfModActorPhysicsDataXML">
		<xs:annotation>
			<xs:documentation>An array that contains one or more of `ModActorPhysicsDataXML`.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ModActorPhysicsDataXML" type="ModActorPhysicsDataXML" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ModActorTypeDataXML">
		<xs:annotation>
			<xs:documentation>Modded Actor Type Data that allows for customizable vanilla or modded Actor Type data.<br/>It's used for any Actor of this Actor Type to determine how they work, including Players where applicable.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ActorType" type="NonSpaceString" minOccurs="1">
				<xs:annotation>
					<xs:documentation>The ID of the `ActorAIDataXML` or `ModActorAIDataXML`. If the `ID` is not unique, it'll modify the Actor Type Data with the same `ID`</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LevelType" type="ActorTypeDataLevelType" minOccurs="0"/>
			<xs:element name="PhysicsType" type="ActorTypeDataPhysicsType" minOccurs="0"/>
			<xs:element name="AIType" type="ActorTypeDataAIType" minOccurs="0"/>
			<xs:element name="BoundsType" type="ActorTypeDataBoundsType" minOccurs="0"/>
			<xs:element name="IdleKeyframes" type="ActorTypeDataIdleKeyframes" minOccurs="0"/>
			<xs:element name="CrouchIdleKeyframes" type="ActorTypeDataCrouchIdleKeyframes" minOccurs="0"/>
			<xs:element name="WalkKeyframes" type="ActorTypeDataWalkKeyframes" minOccurs="0"/>
			<xs:element name="CrouchWalkKeyframes" type="ActorTypeDataCrouchWalkKeyframes" minOccurs="0"/>
